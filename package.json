{
  "name": "subtitle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck:native": "tsgo --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai": "cd src-tauri && cargo test --lib ai_ -- --ignored --nocapture",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write . && biome check --write .",
    "format:check": "prettier --check . && biome check .",
    "lefthook": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@evilmartians/lefthook": "^2.1.5",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@tauri-apps/plugin-stronghold": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^24.12.2",
    "@typescript/native-preview": "^7.0.0-dev.20260404.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0"
  }
